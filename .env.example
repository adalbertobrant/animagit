# GitHub (opcional: sem token o app usa o snapshot local em data/cache)
# Crie em https://github.com/settings/tokens — não precisa de nenhum escopo para dados públicos.
GITHUB_TOKEN=

# Ano a ser animado. Se vazio, usa o ano corrente.
YEAR=2026

# Usuário padrão da landing page.
DEFAULT_USERNAME=adalbertobrant

# Servidor local
HOST=127.0.0.1
PORT=4317

# Qualidade padrão do render: 1080 ou 720
VIDEO_HEIGHT=1080

# Concorrência do Remotion (frames em paralelo). Vazio = 4.
REMOTION_CONCURRENCY=
